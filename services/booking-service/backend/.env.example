PORT=4003
DATABASE_URL=postgres://booking:booking_password@db:5432/booking
PUBLIC_WEB_URL=http://localhost:3002

# ---- Stripe (TEST MODE ONLY) ----
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the dashboard webhook config. If empty, the verify-on-
# return safety net still fulfils bookings, so the demo works without the CLI.
STRIPE_WEBHOOK_SECRET=
CONSULTING_PRICE_CENTS=5000
CURRENCY=usd

# ---- Google Calendar (service account) ----
# Create a service account, enable the Calendar API, share a calendar with the
# service account email ("Make changes to events"), and put that calendar's ID here.
# If these are blank, booking + email still succeed (calendar step is skipped).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# ---- Email ----
# "ethereal" auto-creates a free test inbox at runtime and logs a preview URL.
EMAIL_TRANSPORT=ethereal
EMAIL_FROM="Consulting Booking <bookings@example.com>"
