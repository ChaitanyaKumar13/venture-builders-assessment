# ---- Server ----
PORT=4001

# ---- Database (Postgres) ----
# When running via docker-compose, host is the service name "db".
# For local (non-docker) runs, use localhost.
DATABASE_URL=postgres://aqa:aqa_password@db:5432/aqa

# ---- LLM provider ----
# Choose "ollama" (default, local & free) or "openai" (OpenAI-compatible API).
LLM_PROVIDER=ollama

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
# From inside Docker, reach the host machine's Ollama via host.docker.internal.
# For a local (non-docker) backend run, use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible settings (used when LLM_PROVIDER=openai) ---
# Works with OpenAI, Groq, Together, OpenRouter, etc. Never commit a real key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
