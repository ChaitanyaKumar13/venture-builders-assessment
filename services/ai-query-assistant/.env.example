# Copy to .env for docker-compose. Never commit the real .env.
POSTGRES_USER=aqa
POSTGRES_PASSWORD=aqa_password
POSTGRES_DB=aqa

# LLM provider: "ollama" (default, local) or "openai" (OpenAI-compatible)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Only needed if LLM_PROVIDER=openai — leave blank otherwise, never commit a real key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
